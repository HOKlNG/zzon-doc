{
  "specVersion": 1,
  "title": "데모숍 ERD",
  "kind": "erd",
  "description": "주문 도메인의 핵심 테이블과 그 관계를 보여 준다.",
  "layout": { "direction": "RIGHT" },
  "groups": [],
  "nodes": [
    {
      "id": "order_items",
      "label": "order_items",
      "category": "table",
      "description": "주문에 담긴 상품 한 줄이다. 주문 당시의 가격을 그대로 저장한다.",
      "table": {
        "columns": [
          { "name": "id", "type": "bigint", "pk": true },
          { "name": "order_id", "type": "bigint", "fk": { "table": "orders", "column": "id" } },
          { "name": "product_id", "type": "bigint", "fk": { "table": "products", "column": "id" } },
          { "name": "qty", "type": "int" },
          { "name": "unit_price", "type": "numeric(12,2)" }
        ]
      }
    },
    {
      "id": "orders",
      "label": "orders",
      "category": "table",
      "description": "주문 한 건의 기본 정보다. 상태는 pending, paid, shipped, done 순서로 바뀐다.",
      "table": {
        "columns": [
          { "name": "id", "type": "bigint", "pk": true },
          { "name": "user_id", "type": "bigint", "fk": { "table": "users", "column": "id" } },
          { "name": "status", "type": "varchar(20)" },
          { "name": "total", "type": "numeric(12,2)" },
          { "name": "created_at", "type": "timestamptz" }
        ]
      }
    },
    {
      "id": "products",
      "label": "products",
      "category": "table",
      "description": "판매하는 상품 목록이다.",
      "table": {
        "columns": [
          { "name": "id", "type": "bigint", "pk": true },
          { "name": "name", "type": "varchar(200)" },
          { "name": "price", "type": "numeric(12,2)" },
          { "name": "stock", "type": "int" }
        ]
      }
    },
    {
      "id": "users",
      "label": "users",
      "category": "table",
      "description": "회원 정보다. 지울 때는 행을 없애지 않고 deleted_at에 시각을 남긴다.",
      "table": {
        "columns": [
          { "name": "id", "type": "bigint", "pk": true },
          { "name": "email", "type": "varchar(320)", "unique": true },
          { "name": "name", "type": "varchar(100)" },
          { "name": "deleted_at", "type": "timestamptz", "nullable": true }
        ]
      }
    }
