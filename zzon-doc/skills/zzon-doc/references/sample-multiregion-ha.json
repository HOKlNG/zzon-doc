{
  "specVersion": 1,
  "title": "멀티리전 HA 구성",
  "kind": "infra",
  "description": "두 리전에 같은 구성을 두고, 평소에는 리전 A가 모든 트래픽을 받는다. 리전 A에 장애가 나면 글로벌 DNS가 트래픽을 리전 B로 돌리고, 복제 DB가 주 DB로 승격되어 서비스를 이어 간다.",
  "layout": { "direction": "DOWN" },
  "groups": [
    { "id": "region-a", "label": "리전 A (ap-northeast-2)", "kind": "region" },
    { "id": "region-b", "label": "리전 B (ap-northeast-1)", "kind": "region" }
  ],
  "nodes": [
    {
      "id": "enduser",
      "label": "사용자",
      "category": "user",
      "description": "지연 시간 기반 라우팅으로 가까운 리전에 접속한다"
    },
    {
      "id": "dns",
      "label": "글로벌 DNS",
      "category": "dns",
      "tech": "Route 53",
      "description": "헬스체크 결과를 보고, 리전에 장애가 나면 트래픽을 다른 리전으로 돌린다."
    },
    {
      "id": "lb-a",
      "label": "로드밸런서 A",
      "category": "lb",
      "tech": "ALB",
      "parentId": "region-a",
      "lane": 2,
      "order": 0,
      "description": "리전 A의 진입점으로, 두 가용 영역에 요청을 나눈다."
    },
    {
      "id": "lb-b",
      "label": "로드밸런서 B",
      "category": "lb",
      "tech": "ALB",
      "parentId": "region-b",
      "lane": 2,
      "order": 1,
      "description": "리전 B의 진입점이다."
    },
    {
      "id": "app-a",
      "label": "앱 서버 A",
      "category": "backend",
      "tech": "ECS",
      "parentId": "region-a",
      "lane": 3,
      "order": 0,
      "badge": "AZ ×2",
      "description": "평소 트래픽을 처리하는 앱 서버로, 두 가용 영역에 복제되어 있다."
    },
    {
      "id": "app-b",
      "label": "앱 서버 B",
      "category": "backend",
      "tech": "ECS",
      "parentId": "region-b",
      "lane": 3,
      "order": 1,
      "badge": "AZ ×2",
      "description": "대기 중인 앱 서버로, 평소에는 최소 용량만 띄워 둔다."
    },
    {
      "id": "db-a",
      "label": "주 DB",
      "category": "db",
      "tech": "Aurora",
      "parentId": "region-a",
      "lane": 4,
      "order": 0,
      "badge": "Primary",
      "description": "쓰기를 받는 주 DB로, 리전 B에 비동기로 복제한다."
    },
    {
      "id": "db-b",
      "label": "복제 DB",
      "category": "db",
      "tech": "Aurora Global",
      "parentId": "region-b",
      "lane": 4,
      "order": 1,
      "badge": "Replica",
      "description": "읽기 전용 복제본으로, 장애 전환 때 주 DB로 승격된다."
    }
  ],
  "edges": [
    { "id": "e-enduser-dns", "source": "enduser", "target": "dns", "kind": "http" },
    { "id": "e-dns-lb-a", "source": "dns", "target": "lb-a", "kind": "http", "label": "액티브" },
    { "id": "e-dns-lb-b", "source": "dns", "target": "lb-b", "kind": "http", "label": "페일오버" },
    { "id": "e-lb-a-app-a", "source": "lb-a", "target": "app-a", "kind": "http" },
    { "id": "e-lb-b-app-b", "source": "lb-b", "target": "app-b", "kind": "http" },
    { "id": "e-app-a-db-a", "source": "app-a", "target": "db-a", "kind": "write" },
    { "id": "e-app-b-db-b", "source": "app-b", "target": "db-b", "kind": "read" },
    { "id": "e-db-a-db-b", "source": "db-a", "target": "db-b", "kind": "event", "label": "비동기 복제" }
  ],
  "flows": [
    {
      "id": "normal",
      "label": "평시 경로",
      "description": "평소에는 리전 A가 모든 트래픽을 처리한다",
      "steps": [
        { "edge": "e-enduser-dns", "text": "사용자가 도메인으로 접속한다" },
        { "edge": "e-dns-lb-a", "text": "DNS가 액티브 리전 A로 라우팅한다" },
        { "edge": "e-lb-a-app-a", "text": "로드밸런서가 두 가용 영역의 앱 서버로 요청을 나눈다" },
        { "edge": "e-app-a-db-a", "text": "주 DB에서 읽고 쓴다" },
        { "edge": "e-db-a-db-b", "text": "변경분이 리전 B로 비동기 복제된다" }
      ]
    },
    {
      "id": "failover",
      "label": "페일오버 경로",
      "description": "리전 A에 장애가 나면 DNS가 헬스체크 결과를 보고 리전 B로 전환한다",
      "steps": [
        { "edge": "e-enduser-dns", "text": "사용자 요청이 DNS에 도착한다" },
        { "edge": "e-dns-lb-b", "text": "헬스체크 실패로 리전 B에 라우팅한다" },
        { "edge": "e-lb-b-app-b", "text": "스탠바이 앱이 트래픽을 받는다" },
        { "edge": "e-app-b-db-b", "text": "승격된 복제 DB에서 서비스를 지속한다" }
      ]
    }
  ]
}
