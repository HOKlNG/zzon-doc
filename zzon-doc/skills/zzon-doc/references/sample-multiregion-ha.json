    {
      "id": "lb-b",
      "label": "로드밸런서 B",
      "category": "lb",
      "tech": "ALB",
      "parentId": "region-b",
      "lane": 2,
      "order": 1,
      "description": "리전 B의 진입점입니다."
    },
    {
      "id": "app-a",
      "label": "앱 서버 A",
      "category": "backend",
      "tech": "ECS",
