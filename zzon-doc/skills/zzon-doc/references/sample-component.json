    { "id": "order-api", "label": "주문 API", "category": "backend", "tech": "REST Controller", "parentId": "order-svc", "lane": 1, "description": "요청을 검증하고 로그인 정보를 확인한 뒤 주문 처리에 넘긴다." },

    { "id": "orchestrator", "label": "주문 오케스트레이터", "category": "service", "tech": "Use Case", "parentId": "order-svc", "lane": 2, "description": "재고 확인, 결제, 주문 저장, 이벤트 발행을 차례로 조율한다." },

    { "id": "inventory", "label": "재고 검사기", "category": "service", "parentId": "order-svc", "lane": 3, "order": 0, "description": "상품 재고를 조회해 주문할 수 있는지 판단한다." },
    { "id": "pay-adapter", "label": "결제 어댑터", "category": "service", "parentId": "order-svc", "lane": 3, "order": 1, "description": "결제대행사 API 호출을 한곳에 감싼다." },
    { "id": "publisher", "label": "이벤트 퍼블리셔", "category": "service", "parentId": "order-svc", "lane": 3, "order": 2, "description": "주문 완료 이벤트를 큐 메시지 형식으로 바꿔 발행한다." },

    { "id": "order-db", "label": "주문 DB", "category": "db", "tech": "PostgreSQL", "lane": 4, "order": 0, "href": "sample-erd", "description": "주문과 결제 데이터를 저장한다." },
    { "id": "pg", "label": "토스페이먼츠", "category": "external", "lane": 4, "order": 1, "description": "결제 승인과 취소를 처리하는 외부 결제대행사다." },
    { "id": "mq", "label": "주문 이벤트 큐", "category": "queue", "tech": "SQS", "lane": 4, "order": 2, "href": "sample-event-flow", "description": "주문 완료 이벤트가 쌓이는 큐다." }
  ],
  "edges": [
