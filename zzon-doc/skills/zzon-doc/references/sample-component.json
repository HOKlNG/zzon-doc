        { "edge": "e-orch-inv", "text": "재고 검사기에 주문 가능 여부를 묻는다" },
        { "edge": "e-inv-db", "text": "재고를 조회한다" },
        { "edge": "e-orch-pay", "text": "결제 어댑터에 결제를 위임한다" },
        { "edge": "e-pay-pg", "text": "토스페이먼츠가 결제를 승인한다" },
        { "edge": "e-orch-db", "text": "주문을 확정 상태로 저장한다" },
        { "edge": "e-orch-pub", "text": "완료 사실을 퍼블리셔에 넘긴다" },
        { "edge": "e-pub-mq", "text": "주문 완료 이벤트를 발행한다" }
      ]
